<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Application Submitted Successfully</title>
    <style>
      body {
        font-family: "Segoe UI", Arial, sans-serif;
        background-color: #e8f4fb;
        color: #1a1a1a;
        margin: 0;
        padding: 20px;
      }

      .container {
        background-color: #ffffff;
        border-radius: 10px;
        max-width: 650px;
        margin: 0 auto;
        box-shadow: 0 4px 15px rgba(0, 64, 128, 0.1);
        overflow: hidden;
        border-top: 6px solid #0056b3;
      }

      .header {
        background: linear-gradient(90deg, #004080, #007bff);
        color: #fff;
        padding: 20px;
        text-align: center;
      }

      .header h1 {
        margin: 0;
        font-size: 20px;
        letter-spacing: 0.5px;
      }

      .content {
        padding: 25px;
        line-height: 1.6;
      }

      .content p {
        font-size: 14px;
        margin: 8px 0;
      }

      .info-box {
        background-color: #f0f8ff;
        border-left: 4px solid #007bff;
        padding: 15px;
        border-radius: 6px;
        margin: 20px 0;
      }

      .info-box strong {
        color: #004080;
      }

      .info-box ul {
        list-style: none;
        padding: 0;
        margin: 10px 0;
        font-size: 13px;
      }

      .info-box li {
        margin: 5px 0;
        padding: 6px 0;
        border-bottom: 1px solid #e3e9f0;
      }

      .footer {
        background: #004080;
        color: #fff;
        text-align: center;
        padding: 15px;
        font-size: 12px;
      }

      .footer a {
        color: #80d4ff;
        text-decoration: none;
      }

      .footer .tagline {
        color: #cce6ff;
        margin-top: 8px;
      }

      .social-section {
        background: #f8fbff;
        padding: 20px;
        text-align: center;
        border-top: 1px solid #e3f2fd;
      }

      .social-section h3 {
        color: #004080;
        font-size: 13px;
        margin-bottom: 12px;
      }

      .social-links {
        display: flex;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
      }

      .social-link {
        display: inline-block;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #ffffff;
        border: 1.2px solid #007bff50;
        box-shadow: 0 2px 5px rgba(0, 64, 128, 0.1);
        text-decoration: none;
      }

      .social-link img {
        width: 16px;
        height: 16px;
        display: block;
        margin: 9px auto;
      }

      .highlight {
        color: #007bff;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <!-- HEADER -->
      <div class="header">
        <h1>✅ Student Application Received Successfully</h1>
      </div>

      <!-- CONTENT -->
      <div class="content">
        <p>Dear <strong>Sir/Madam</strong>,</p>
        <p>
          We are delighted to inform you that a new application has been
          <strong>successfully submitted</strong> for admission to your college,
          <span class="highlight"><%= collegeName %></span>,
          under the program
          <span class="highlight"><%= courseName %></span>.
        </p>

        <div class="info-box">
          <strong>📄 Student Application Details</strong>
          <ul>
            <li><strong>Application ID:</strong> <%= applicationId %></li>
            <li><strong>Student Name:</strong> <%= studentName %></li>
            <li><strong>Course Name:</strong> <%= courseName %></li>
            <li><strong>Date of Birth:</strong> <%= dob %></li>
            <li><strong>Email:</strong> <%= email %></li>
            <li><strong>Mobile:</strong> <%= mobile %></li>
            <li><strong>Gender:</strong> <%= gender %></li>
            <li><strong>Father's Name:</strong> <%= fatherName %></li>
            <li><strong>Mother's Name:</strong> <%= motherName %></li>
            <li><strong>Address:</strong> <%= address %></li>
            <li><strong>City:</strong> <%= city %></li>
            <li><strong>State:</strong> <%= state %></li>
            <li><strong>Pincode:</strong> <%= pincode %></li>
            <li><strong>Class 10th Percentage:</strong> <%= tenthPercentage %></li>
            <li><strong>Class 12th Percentage:</strong> <%= twelfthPercentage %></li>
          </ul>
        </div>

        <p>
          The student's documents have been attached for your review. Please
          verify and process the admission request at your earliest
          convenience.
        </p>

        <p>
          You can also track this application in the
          <strong>College Connect Portal</strong>.
        </p>
      </div>

      <!-- CONTACT INFO -->
      <div style="background:#f4f9ff;padding:20px;border-top:1px solid #dceeff;">
        <p style="margin:5px 0;"><strong>Warm Regards,</strong></p>
        <p style="margin:5px 0;">
          <strong>Admissions Team — College Connect</strong><br />
          Patna, Bihar - 800001 <br />
          Email:
          <a href="mailto:info@collegeconnectt.com">info@collegeconnectt.com</a>
          <br />
          Helpline:
          <a href="tel:+919342293422">+91 93422 93422</a>
        </p>
      </div>

      <!-- SOCIAL LINKS -->
      <div class="social-section">
        <h3>Follow College Connect</h3>
        <div class="social-links">
          <a href="https://facebook.com" target="_blank" class="social-link">
            <img
              src="https://api.nagarparishadjhajha.in/uploads/icons/facebook.png"
              alt="Facebook"
            />
          </a>
          <a href="https://instagram.com" target="_blank" class="social-link">
            <img
              src="https://api.nagarparishadjhajha.in/uploads/icons/instagram.png"
              alt="Instagram"
            />
          </a>
          <a href="https://linkedin.com" target="_blank" class="social-link">
            <img
              src="https://api.nagarparishadjhajha.in/uploads/icons/linkedin.png"
              alt="LinkedIn"
            />
          </a>
          <a href="https://twitter.com" target="_blank" class="social-link">
            <img
              src="https://api.nagarparishadjhajha.in/uploads/icons/twitter.png"
              alt="Twitter"
            />
          </a>
          <a href="https://youtube.com" target="_blank" class="social-link">
            <img
              src="https://api.nagarparishadjhajha.in/uploads/icons/youtube.png"
              alt="YouTube"
            />
          </a>
        </div>
      </div>

      <!-- FOOTER -->
      <div class="footer">
        <p><strong>College Connect</strong></p>
        <p>Helpline: +91 76676 56421</p>
        <p>This is an automated email. Please do not reply.</p>
        <p class="tagline">Empowering admissions with trust 💙</p>
      </div>
    </div>
  </body>
</html>
